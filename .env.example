APP_NAME="Dada Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL local : « docker compose up -d » (voir docker-compose.yml)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dada_hub
DB_USERNAME=dada
DB_PASSWORD=dada

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EXTRACT_MODEL=gpt-5-nano
OPENAI_EXTRACT_REASONING=minimal

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EXTRACT_MODEL=claude-haiku-5-5

# Coach sportif : toujours Claude (clé ANTHROPIC_API_KEY), quel que soit AI_PROVIDER.
COACH_AI_MODEL=claude-opus-5-5
COACH_AI_EFFORT=medium

# Strava (application créée sur strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_SUBSCRIPTION_ID=

# Google Health (client OAuth « Application Web » créé dans Google Cloud, API Google Health activée)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

FIRECRAWL_API_KEY=

HUB_REGISTRATION=false

# Premier compte créé au démarrage s'il n'existe pas (production sans terminal)
HUB_ADMIN_EMAIL=
HUB_ADMIN_PASSWORD=
HUB_ADMIN_NAME=
